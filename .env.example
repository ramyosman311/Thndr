# =============================================================================
# MIZAN Smart Portfolio Manager — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# See DEPLOYMENT.md for the full production configuration guide.
# =============================================================================

# --- Application ---
# development | production. Never "production" locally, never anything
# else in a real deployment -- several safety checks key off this
# (debug mode, DEV_MODE, the seed script's production guard).
APP_ENV=development
APP_NAME="MIZAN Smart Portfolio Manager"
# Must be false in production (also forced off by is_production regardless).
APP_DEBUG=true
# Development mode disables authentication enforcement. See ARCHITECTURE.md
# (Auth Boundary). MUST be false in any production deployment.
DEV_MODE=true

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
# Local/Docker Compose default. Many hosting platforms (Render, Railway,
# etc.) instead inject a dynamic $PORT the container must bind to --
# backend/Dockerfile's CMD already reads $PORT with this as its fallback,
# so this value is not itself passed to a platform deployment.
BACKEND_PORT=8000
# Comma-separated, explicit origins -- never "*" in production. Must
# include the production web/PWA origin, and the Capacitor native app's
# WebView origin (https://localhost, since mobile/capacitor/capacitor.config.ts
# sets server.androidScheme: "https") once a native build is distributed.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL / Supabase) ---
# Production: a durable managed PostgreSQL connection string (this project's
# documented choice is Supabase-hosted Postgres -- see DEPLOYMENT.md,
# "Database"). Local dev: a local/dockerized PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thndr_portfolio
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/thndr_portfolio

# --- Supabase ---
# SUPABASE_URL (P0-3B): the project's base URL (e.g.
# https://<project-ref>.supabase.co). Required for require_supabase_user
# to verify Authorization: Bearer <Supabase JWT> -- it derives both the
# expected issuer (`{SUPABASE_URL}/auth/v1`) and the JWKS endpoint
# (`{SUPABASE_URL}/auth/v1/.well-known/jwks.json`) from it. Left unset ->
# require_supabase_user fails closed (401 on every request), it never
# falls back to "anything verifies". Every non-health route requires it
# (see DECISIONS.md, "P0-3C").
SUPABASE_URL=
# Supabase's own documented standard audience claim for every access
# token it issues -- override only if a future Supabase configuration
# changes this (uncommon).
SUPABASE_JWT_AUDIENCE=authenticated
# Reserved, not read by any code today -- only relevant if a future phase
# needs the Supabase service-role key for server-side admin API calls.
# Never put a real value here without a corresponding code path that
# reads it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
# A strong, unique, randomly generated value in production -- never this
# placeholder. (Not currently used to sign anything -- reserved for the
# future real authentication boundary described in ARCHITECTURE.md.)
SECRET_KEY=change-me-in-production

# Required whenever DEV_MODE=false. Since P0-3C this is NOT an
# `Authorization` credential (that header carries the user's Supabase JWT):
# it is the server-to-server `X-Internal-Proxy-Token` the Vercel proxy adds
# (see app/core/auth.py). It is not identity and never substitutes for the
# JWT. The app refuses to start with DEV_MODE=false and this unset. Generate
# with e.g. `openssl rand -hex 32`; never reuse SECRET_KEY for this. The
# frontend's server-side proxy needs the exact same value as its own
# (non-NEXT_PUBLIC_) API_AUTH_TOKEN env var on Vercel -- see DEPLOYMENT.md,
# "Authentication". Native/Capacitor clients never have it.
API_AUTH_TOKEN=

# Development seed only (`python -m app.seed`): a Supabase Auth user uuid that
# will own the newly-seeded portfolio. Unset => the seeded portfolio is
# unowned and invisible to every authenticated request. Never set in production.
SEED_OWNER_USER_ID=

# --- Telegram Notifications ---
# Backend-only. Never expose these to the frontend (never prefix with
# NEXT_PUBLIC_), never hard-code them, never log them (see
# services/telegram_dispatcher.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- Development seed data safety valve ---
# Set to 1 only to deliberately run `python -m app.seed` against
# APP_ENV=production (e.g. seeding a pre-launch demo instance). Leave
# unset otherwise -- the seed script refuses to run in production by
# default, since it would inject fake demo assets into a real portfolio.
ALLOW_SEED_IN_PRODUCTION=

# --- Frontend (Next.js) ---
# Web/PWA: leave unset (defaults to relative "/api"). The browser only
# ever calls this Next.js app's own origin -- app/api/[...path]/route.ts
# is a server-side proxy that forwards to the real backend and attaches
# API_AUTH_TOKEN itself, so the token is never shipped to the browser
# (see DEPLOYMENT.md, "Authentication"). A Capacitor native build is the
# one exception: it ships with no server of its own, so it still requires
# this to be an explicit, durable HTTPS URL pointed straight at the
# backend -- see DEPLOYMENT.md, "Capacitor Native Builds" -- never a
# Codespace/tunnel/localhost URL for that build.
NEXT_PUBLIC_API_BASE_URL=

# Web login (P0-3D). The Supabase project URL and its ANON (publishable) key
# -- both public by design and shipped to the browser; the row-level truth is
# the backend verifying the user's JWT. NEVER put the service-role key, the
# API_AUTH_TOKEN or any other secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend-only for the Next.js server (never NEXT_PUBLIC_ -- read solely
# by app/api/[...path]/route.ts, which runs server-side on Vercel and is
# never sent to the browser). Local dev: leave both unset -- the proxy
# falls back to http://127.0.0.1:8000/api and, since DEV_MODE=true there,
# no Authorization header is needed either. In production, set this
# Vercel-side API_AUTH_TOKEN to the exact same value as the backend's
# (see "Security" above) -- it is a separate env var on a separate
# platform, not something copied automatically.
BACKEND_API_URL=
