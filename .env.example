# =============================================================================
# THNDR Smart Portfolio — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME="THNDR Smart Portfolio"
APP_DEBUG=true
# Development mode disables authentication enforcement. See ARCHITECTURE.md (Auth Boundary).
DEV_MODE=true

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL / Supabase) ---
# Production: use Supabase PostgreSQL connection string.
# Local dev: point at a local/dockerized PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thndr_portfolio
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/thndr_portfolio

# --- Supabase (optional, if using Supabase-managed Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
SECRET_KEY=change-me-in-production

# --- Telegram Notifications ---
# Never expose these to the frontend. Never hard-code them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- Market Data Provider ---
# When unset, the system falls back to MockMarketDataProvider (explicitly marked as MOCK).
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
